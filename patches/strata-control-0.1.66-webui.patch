+// OAI patch: smooth streaming. Each frame used to set the whole thinking text again (tens of thousands of characters)
+// and rebuild the whole answer (Markdown and every tool block), so a long reply stuttered and an opened tool block
+// closed again. Now the thinking text is appended and the answer keeps every part that did not change.
+function setThinking(body, text) {
+  const n = body._n;
+  const atEnd = body.scrollHeight - body.scrollTop - body.clientHeight < 24;   // follow the end unless the reader scrolled up
+  if (n != null && text.length >= n && body.childNodes.length < 2000) {
+    if (text.length > n) body.appendChild(document.createTextNode(text.slice(n)));
+  } else {
+    body.textContent = text;
+  }
+  body._n = text.length;
+  if (atEnd) body.scrollTop = body.scrollHeight;
+}
+// Split an answer into sections that markdown() renders the same alone as together: a cut goes only at a blank line
+// outside a code block, before a heading or a ``` fence or after a closed one. Fences are matched as markdown() does.
+function mdBlocks(text) {
+  if (!text) return [];
+  const out = [];
+  let cur = [], fence = false, prevBlank = false, afterFence = false;
+  for (const line of text.split("\n")) {
+    const blank = !line.trim();
+    const open = !fence && /^```[^`]*$/.test(line);
+    if (!fence && prevBlank && cur.length && !blank && (open || afterFence || /^#{1,6}\s/.test(line))) {
+      out.push(cur.join("\n"));
+      cur = [];
+    }
+    if (!blank) afterFence = false;
+    cur.push(line);
+    if (open) fence = true;
+    else if (fence && /^```[ \t]*$/.test(line)) { fence = false; afterFence = true; }
+    prevBlank = blank;
+  }
+  out.push(cur.join("\n"));
+  return out;
+}
+function answerParts(m) {
+  const parts = [];
+  // each Markdown section is its own part: while streaming only the last one is rebuilt, the rest keep their DOM
+  const seg = (text, key) => { mdBlocks(text).forEach((b, j) => parts.push({key: `${key}.${j}`, sig: b, html: () => answerMarkdown(b)})); };
+  if (!m.tools || !m.tools.length) { seg(m.text || "", "t"); return parts; }
+  let pos = 0;
+  m.tools.forEach((t, k) => {
+    const at = Math.min(Math.max(t.at || 0, pos), m.text.length);
+    if (at > pos) seg(m.text.slice(pos, at), `t${k}`);
+    pos = at;
+    const sig = [t.state, t.open ? 1 : 0, t.ms, t.result == null ? -1 : t.result.length, t.name, t.server,
+                 t.arguments == null ? -1 : JSON.stringify(t.arguments).length, (t.images || []).length].join("|");
+    parts.push({key: `x${k}`, sig, html: () => toolHtml(t, k) + toolImages(t)});
+  });
+  seg(m.text.slice(pos), "t$");
+  return parts;
+}
+// A code block still being written only grows: put the new text into its <code> and keep the block, its header and
+// buttons (rebuilding them on every token made the icons and the scroll jitter). Same text as markdown() would give.
+function openCode(sig) {
+  const nl = sig.indexOf("\n");
+  if (nl < 0 || !/^```[^`]*$/.test(sig.slice(0, nl))) return null;
+  const body = sig.slice(nl + 1);
+  if (/(^|\n)```[ \t]*(\n|$)/.test(body)) return null;
+  return {head: sig.slice(0, nl), body};
+}
+function growCode(o, p) {
+  if (settings.math) return false;
+  const a = openCode(o.sig), b = openCode(p.sig);
+  const code = o.node.querySelector(".st-code pre > code");
+  if (!a || !b || a.head !== b.head || !code || o.node.querySelectorAll(".st-code").length !== 1) return false;
+  code.textContent = b.body;
+  o.sig = p.sig;
+  return true;
+}
+function paintAnswer(bubble, m) {
+  const parts = answerParts(m);
+  if (!bubble._parts) { bubble.textContent = ""; bubble._parts = []; }
+  const old = bubble._parts;
+  parts.forEach((p, i) => {
+    const o = old[i];
+    if (o && o.key === p.key && o.sig === p.sig) return;
+    if (o && o.key === p.key && growCode(o, p)) return;
+    const node = document.createElement("div");
+    node.className = "ans-part";
+    node.innerHTML = p.html();
+    hydrateToolImages(node);
+    if (settings.math) StrataMath.hydrate(node);
+    if (o) bubble.replaceChild(node, o.node); else bubble.appendChild(node);
+    old[i] = {key: p.key, sig: p.sig, node};
+  });
+  while (old.length > parts.length) bubble.removeChild(old.pop().node);
+}
