diff --git a/serve/web/app.css b/serve/web/app.css
index cd9140c..f131c73 100644
--- a/serve/web/app.css
+++ b/serve/web/app.css
@@ -375,3 +375,47 @@ a.st-header__brand:hover { color: var(--st-accent-text); text-decoration: none;
 /* a message may use the room a wide window gives the chat column (#3176 widened the column; the kit's 720px kept the messages narrow in it) */
 .st-msg { max-width: min(100%, 900px); }
 .st-toast .st-btn { white-space: nowrap; }
+
+/* ---- OAI patch: smoother chat and a llama-ui look (G:\Work\OAI\patches\strata-control-0.1.66-webui.patch) ---- */
+[data-theme="dark"]{--st-bg:#121212;--st-surface:#1a1a1a;--st-surface-2:#202020;--st-line:#2d2d2d;--st-line-soft:#252525;
+  --st-ink:#ececec;--st-ink-soft:#d4d4d4;--st-ink-muted:#9b9b9b;--st-icon:#cfcfcf}
+.chat { max-width: min(100%, 900px); }
+.st-composer { max-width: min(100%, 900px); }
+.st-msg { max-width: 100%; }
+.st-msg--user { max-width: 80%; }
+.st-msg--user .st-bubble { background: var(--st-surface-2); color: var(--st-ink); border: 1px solid var(--st-line); border-radius: 18px; }
+.st-msg--assistant .st-bubble { background: transparent; border: 0; padding: 2px 2px 4px; }
+.ans-part { display: contents; }
+.st-bubble > .ans-part:first-child > :first-child { margin-top: 0; }
+.st-bubble > .ans-part:last-child > :last-child { margin-bottom: 0; }
+.st-bubble .tool-call { margin: 6px 0; border-radius: 10px; background: var(--st-surface); contain: content; }
+.tool-call > summary { padding: 6px 10px; }
+.st-collapse.think { background: var(--st-surface); border-radius: 10px; }
+.st-collapse__body.thinking { font-size: var(--st-fs-sm); color: var(--st-ink-muted); max-height: 300px; contain: content; }
+.st-msg__meta { opacity: .85; }
+/* earlier replies are not laid out while off screen: a long chat stays light */
+.st-msg:not(:last-child) { content-visibility: auto; contain-intrinsic-size: auto 300px; }
+/* what the model is doing now, inside the reply */
+.live-status { display: flex; align-items: center; gap: 8px; font-size: var(--st-fs-sm); color: var(--st-ink-muted); padding: 2px 2px 4px; }
+.live-status[hidden], .live-status__bar[hidden] { display: none; }
+.live-status__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--st-accent); flex: none; animation: live-pulse 1.2s ease-in-out infinite; }
+.live-status__bar { flex: 1; max-width: 260px; height: 4px; border-radius: 2px; background: var(--st-line); overflow: hidden; }
+.live-status__bar > span { display: block; height: 100%; width: 0; background: var(--st-accent); transition: width .5s linear; }
+@keyframes live-pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
+@media (prefers-reduced-motion: reduce) { .live-status__dot { animation: none; } .live-status__bar > span { transition: none; } }
+/* OAI patch: smooth activity animations. Strata's `blink 1s steps(2)` with a 50% keyframe steps each half on its
+   own, so the caret and the tool badge went bright / half / off / half every 250 ms and read as a 4 fps stutter.
+   Now a continuous fade (opacity only, runs on the compositor). The caret is a thin text cursor and is not drawn
+   on its own line after a tool block: the status line under the answer already shows the activity there. */
+@keyframes oai-fade { 0%, 100% { opacity: 1; } 50% { opacity: .15; } }
+.cursor::after { width: 3px; border-radius: 1px; animation: oai-fade 1.1s ease-in-out infinite; }
+.st-bubble.cursor:has(> .ans-part:last-child .tool-call)::after { display: none; }
+.tool-call[data-state="running"] .st-badge::before, .tool-call[data-state="writing"] .st-badge::before {
+  animation: oai-fade 1.2s ease-in-out infinite; }
+@media (prefers-reduced-motion: reduce) {
+  .cursor::after, .tool-call .st-badge::before { animation: none; }
+}
+
+/* OAI patch: history compaction - the messages the model no longer reads, and the summary that stands for them */
+.st-msg.oai-compacted { opacity: .45; }
+.st-msg.oai-summary .st-bubble { border-left: 3px solid rgba(127, 127, 127, .55); padding-left: 14px; }
