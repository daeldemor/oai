             man.dspark[kv.first] = std::move(ti);
         }
 
@@ -1569,6 +1571,15 @@ struct InkCudaModel {
                          n_vram_experts, primary_gpu, n_peer_experts, peer_gpu, n_host_experts, t_exp,
