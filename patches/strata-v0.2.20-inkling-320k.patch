+        if (const char* tw = std::getenv("STRATA_INK_TRIM_WS"); tw && std::atoi(tw) > 0) {
+            const BOOL ok = SetProcessWorkingSetSize(GetCurrentProcess(), (SIZE_T)-1, (SIZE_T)-1);
+            std::fprintf(stderr, "[InkCUDA] working set trimmed after load (%s)\n", ok ? "ok" : "failed");
+        }
+#endif
