--- a/engine/src/inkling2/cuda/ink_hybrid.cuh
+++ b/engine/src/inkling2/cuda/ink_hybrid.cuh
@@ -1000,7 +1000,13 @@ struct InkHybridEngine {
         h_sec4_bytes = bytes;
         const uint64_t avail = ink_ram_available_bytes();
 #ifdef _WIN32
-        const bool try_pin = (bytes <= (8ull << 30)) && (avail == 0 || (double)bytes < 0.35 * (double)avail);
+        // STRATA_INK_PIN_FRAC (opt-in, e.g. 0.6): pin the host expert arena up to this share of available RAM,
+        // without the 8 GiB cap. Unset keeps the release rule (8 GiB cap, 35%).
+        const char* pin_env = std::getenv("STRATA_INK_PIN_FRAC");
+        const double pin_frac = pin_env ? std::atof(pin_env) : 0.0;
+        const bool try_pin = (pin_frac > 0.0)
+            ? (avail == 0 || (double)bytes < pin_frac * (double)avail)
+            : ((bytes <= (8ull << 30)) && (avail == 0 || (double)bytes < 0.35 * (double)avail));
 #else
         const bool try_pin = (avail == 0 || (double)bytes < 0.45 * (double)avail);
 #endif
