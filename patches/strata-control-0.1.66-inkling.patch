+def _think_before_turns(prompt: str, empty_think: str) -> str:
+    """OAI patch: with tools, every reply was generated after the empty thinking turn that finish_prompt appends, but
+    the template renders past replies without it. The next prompt then differs from the cached one right there and
+    the engine reads the whole conversation again on every tool round (reused=0). Put the same empty turn in front
+    of each past reply, so the previous prompt is a prefix of the next one and its checkpoint is reused."""
+    out, cut, prev_end, prev_model, turn_open = [], 0, 0, False, False
+    for m in _ROLE_TAG.finditer(prompt):
+        is_model = m.group(1) == "model"
+        if prev_model and END_SAMPLING in prompt[prev_end:m.start()]:
+            turn_open = False                      # the previous reply ended: this header starts a new one
+        if is_model:
+            if not turn_open and m.end() < len(prompt):    # (a bare opener at the end is finish_prompt's to close)
+                if not prompt.startswith(f"{CONTENT_THINK}{END_MSG}", m.end()):
+                    out.append(prompt[cut:m.start()])
+                    out.append(empty_think)
+                    cut = m.start()
+                turn_open = True
+        else:
+            turn_open = False
+        prev_model, prev_end = is_model, m.end()
+    out.append(prompt[cut:])
+    return "".join(out)
